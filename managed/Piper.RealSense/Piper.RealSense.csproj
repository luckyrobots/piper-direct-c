<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Intel.RealSense</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>SYSLIB0003;SYSLIB0004</NoWarn>
  </PropertyGroup>
  <!-- Compile only the wrapper types the camera worker uses (context, devices,
       pipeline, frames, stream profiles) and what they depend on. The rest of
       the vendored SDK stays on disk unchanged. -->
  <PropertyGroup><RealSense>../../vendor/realsense/Intel.RealSense</RealSense></PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RealSense)/**/*.cs" />
    <Compile Remove="$(RealSense)/Processing/**/*.cs" />
    <Compile Remove="$(RealSense)/Devices/*.cs;$(RealSense)/Sensors/SoftwareSensor.cs;$(RealSense)/Types/FwLog.cs;$(RealSense)/Types/FwParsedLog.cs;$(RealSense)/Types/TerminalParser.cs" />
    <Compile Include="$(RealSense)/Devices/Device.cs;$(RealSense)/Devices/DeviceList.cs;$(RealSense)/Devices/PlaybackDevice.cs;$(RealSense)/Processing/ProcessingBlock.cs;$(RealSense)/Processing/ProcessingBlockList.cs" />
  </ItemGroup>
</Project>
